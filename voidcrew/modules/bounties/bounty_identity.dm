/**
 * # Bounty hunting: who a criminal is
 *
 * Owner: P1 identity. Owns this file, bounty_looks.dm, strings/bounty_criminals.json,
 * voidcrew/_DEFINES/bounty_identity.dm and the tests in
 * voidcrew/modules/unit_tests/voidcrew_bounty_identity.dm. Do not edit this file outside P1.
 *
 * What it owns: making a criminal's record (name and alias, species, gender, crime, style or kit,
 * distinguishing features, prison traits), decoy records that share some features, the examine
 * lines for features, and what criminals say: bounty_say() and its dialogue file (spec sections
 * 2 and 9).
 *
 * The record's vars are declared in bounty_types.dm and nowhere else; a var only P1 uses goes here
 * with an `identity_` prefix. The procs below start as P0 stubs.
 */

/**
 * A new record for a criminal of `tier` (BOUNTY_TIER_*) and `archetype` (BOUNTY_ARCHETYPE_*),
 * wanted at a `placement_kind` (BOUNTY_PLACEMENT_*) site: everything filled in.
 *
 * P0 stub: a minimal record with a random human name.
 */
/proc/generate_bounty_record(tier, archetype, placement_kind)
	var/datum/bounty_record/record = new
	record.tier = tier || BOUNTY_TIER_PETTY
	record.archetype = archetype || BOUNTY_ARCHETYPE_MEEK
	record.gender = pick(MALE, FEMALE)
	record.species = /datum/species/human
	record.name = generate_random_name_species_based(record.gender, TRUE, /datum/species/human)
	record.alias = record.name
	record.crime = "smuggling"
	return record

/**
 * A record for a decoy at a trader outpost who looks like `wanted` in `shared` of its features,
 * and never in all of them.
 *
 * P0 stub: an unrelated petty meek record.
 */
/proc/make_decoy_record(datum/bounty_record/wanted, shared)
	return generate_bounty_record(BOUNTY_TIER_PETTY, BOUNTY_ARCHETYPE_MEEK)

/// Their distinguishing features as examine lines. P0 stub: none.
/datum/bounty_record/proc/feature_lines()
	return list()

/**
 * Says a line for `context` (the contexts in strings/bounty_criminals.json) through a per-mob
 * cooldown and a no-repeat window. Returns TRUE if they said something.
 *
 * P0 stub: says nothing.
 */
/mob/living/proc/bounty_say(context)
	return FALSE
