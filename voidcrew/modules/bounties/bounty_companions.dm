/**
 * # Bounty hunting: a criminal's companions
 *
 * Owner: P3 AI. Do not edit this file outside P3.
 *
 * What it owns: /mob/living/basic/bounty_companion (its body, its built-in values and its AI) and
 * spawning companions beside a normal criminal. Companions fight with the criminal, are not
 * bounties and pay nothing (spec section 3).
 *
 * The shared vars are declared in bounty_types.dm and nowhere else; a var only P3 uses goes here
 * with an `ai_` prefix. The procs below start as P0 stubs.
 */

// P0 placeholder values, P3's to change.
/mob/living/basic/bounty_companion
	name = "companion"
	desc = "Someone keeping bad company."
	icon = 'icons/mob/simple/simple_human.dmi'
	maxHealth = 100
	health = 100
	mob_biotypes = MOB_ORGANIC | MOB_HUMANOID
	sentience_type = SENTIENCE_HUMANOID

/**
 * Spawns `count` companions at their side, remembered in `companions` and on the posting. Returns
 * the companions spawned.
 *
 * P0 stub: spawns none.
 */
/mob/living/basic/bounty_criminal/proc/spawn_companions(count)
	return list()
