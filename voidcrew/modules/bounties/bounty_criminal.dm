/**
 * # Bounty hunting: the criminal's body
 *
 * Owner: P2 body. Owns this file, bounty_restraints.dm, voidcrew/_DEFINES/bounty_criminals.dm, the
 * bounty exemption line in voidcrew/_HELPERS/hostile_creatures.dm and the tests in
 * voidcrew/modules/unit_tests/voidcrew_bounty_criminal.dm. Do not edit this file outside P2.
 *
 * What it owns: the criminal mob's body (health, stamina, status flags and the built-in values of
 * /mob/living/basic/bounty_criminal, /meek and /normal), the downed state and its mercy rule and
 * recovery, capture_state(), refusing teleports and polymorph, the planet-sweep protection,
 * spawn_bounty_criminal(), the leash and who it may attack (spec section 4).
 *
 * The shared vars are declared in bounty_types.dm and nowhere else; a var only P2 uses goes here
 * with a `body_` prefix. The procs below start as P0 stubs that change nothing.
 */

// P0 placeholder values, P2's to change. The meek and normal health are BOUNTY_MEEK_HEALTH and
// BOUNTY_NORMAL_HEALTH (voidcrew/_DEFINES/bounty_criminals.dm).
/mob/living/basic/bounty_criminal
	name = "criminal"
	desc = "Someone with a price on their head."
	icon = 'icons/mob/simple/simple_human.dmi'
	maxHealth = 100
	health = 100
	mob_biotypes = MOB_ORGANIC | MOB_HUMANOID
	sentience_type = SENTIENCE_HUMANOID

/**
 * Spawns the criminal for `record` at `where`, wanted on `posting` (or on nothing, for an admin
 * spawn): the subtype for its archetype and kit, dressed in its look, protected from the planet
 * sweep. Returns the mob.
 *
 * P0 stub: a base criminal with the record's name and nothing else.
 */
/proc/spawn_bounty_criminal(datum/bounty_record/record, turf/where, datum/criminal_bounty/posting)
	if(!where)
		return null
	var/mob/living/basic/bounty_criminal/criminal = new(where)
	criminal.record = record
	if(record?.name)
		criminal.name = record.name
		criminal.real_name = record.name
	if(posting)
		criminal.posting_ref = WEAKREF(posting)
	return criminal

/**
 * What the pad pays on (BOUNTY_STATE_*), checked in order: dead, downed (even if cuffed),
 * restrained, stunned (stamina crit, knocked down, paralysed or surrendered), free.
 *
 * P0 stub: dead or free.
 */
/mob/living/basic/bounty_criminal/proc/capture_state()
	return stat == DEAD ? BOUNTY_STATE_DEAD : BOUNTY_STATE_FREE

/// Whether they are at or below the downed line. P0 stub: never.
/mob/living/basic/bounty_criminal/proc/is_downed()
	return FALSE

/// Whether restraints are on them. P0 stub: never.
/mob/living/basic/bounty_criminal/proc/is_restrained()
	return FALSE

/// Whether they may go onto `destination`: inside their site_bounds, and never into a ship, a player outpost or a hangar. P0 stub: anywhere.
/mob/living/basic/bounty_criminal/proc/leash_ok(turf/destination)
	return TRUE

/// Whether they may attack `target`: off their site (and at a trader outpost) only those on their grudge list, and no structures. P0 stub: anything.
/mob/living/basic/bounty_criminal/proc/may_attack(atom/target)
	return TRUE
