/**
 * # Bounty hunting: the board
 *
 * Owner: P5 board. Owns this file, bounty_posting.dm, bounty_placement.dm, bounty_turn_in.dm,
 * voidcrew/_DEFINES/bounty_board.dm, the ui_data() and ui_act() additions in
 * voidcrew/modules/missions/mission_board.dm, tgui/packages/tgui/interfaces/MissionBoard.tsx and
 * the tests in voidcrew/modules/unit_tests/voidcrew_bounty_board.dm. Do not edit this file outside
 * P5.
 *
 * What it owns: SScriminal_bounties, the board manager: posting public bounties and private offers
 * up to their caps, expiry, and the board's ten-second tick (spec sections 1, 2 and 10).
 *
 * The shared vars are declared in bounty_types.dm and nowhere else; a var only P5 uses goes here
 * with a `board_` prefix. The procs below start as P0 stubs.
 */

SUBSYSTEM_DEF(criminal_bounties)
	name = "Criminal Bounties"
	wait = 10 SECONDS
	// Nothing to set up while the world loads: the board fills itself from its ticks. If an
	// Initialize() is ever added, drop SS_NO_INIT and list the subsystems it needs in
	// `dependencies`; the MC orders init by those and overwrites init_order.
	flags = SS_BACKGROUND | SS_NO_INIT
	runlevels = RUNLEVEL_GAME

/datum/controller/subsystem/criminal_bounties/fire(resumed)
	board_tick()

/**
 * The board's tick, every 10 seconds of the round: expiry, posting up to BOUNTY_MAX_PUBLIC, and
 * anything else the board does on a clock.
 *
 * P0 stub: nothing happens.
 */
/datum/controller/subsystem/criminal_bounties/proc/board_tick()
	return

/**
 * Posts a bounty now: a criminal of `tier` (BOUNTY_TIER_*) at a `placement_kind`
 * (BOUNTY_PLACEMENT_*) site, at `site` (an /obj/structure/overmap planet, ruin, pirate ship or
 * trader outpost) or one the board picks, public or offered only to the ship `private_to`.
 * Returns the posting (/datum/criminal_bounty), or null if none could be made.
 *
 * P0 stub: posts nothing.
 */
/proc/post_criminal_bounty(tier, placement_kind, obj/structure/overmap/site = null, obj/structure/overmap/ship/private_to = null)
	return null
