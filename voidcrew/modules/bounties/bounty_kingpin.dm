// THE OFFER ON THE TABLE
// =========================================================================

/**
 * # The kingpin's offer
 *
 * The bribe, shown on the coffee table: it looks like the item and examines as the item, but the
 * item itself stays inside until someone takes the deal. Nobody picks it up for free.
 */
/obj/effect/bounty_kingpin_offer
	name = "offer"
	desc = "Something on the table."
	anchored = TRUE
	/// What is on offer, held here until someone takes the deal
	var/obj/item/offer_item

/obj/effect/bounty_kingpin_offer/Initialize(mapload, obj/item/item)
	. = ..()
	if(!istype(item))
		return INITIALIZE_HINT_QDEL
	offer_item = item
	item.forceMove(src)
	RegisterSignal(item, COMSIG_QDELETING, PROC_REF(on_item_deleted))
	appearance = item.appearance
	name = item.name
	layer = ABOVE_OBJ_LAYER
	plane = GAME_PLANE
	pixel_x = 0
	pixel_y = 6
	invisibility = 0
	mouse_opacity = MOUSE_OPACITY_ICON

/obj/effect/bounty_kingpin_offer/Destroy()
	if(offer_item)
		UnregisterSignal(offer_item, COMSIG_QDELETING)
		if(offer_item.loc == src)
			qdel(offer_item)
		offer_item = null
	return ..()

/obj/effect/bounty_kingpin_offer/examine(mob/user)
	. = offer_item ? offer_item.examine(user) : ..()
	. += span_notice("It's the kingpin's offer. Take the deal and it's yours.")

/obj/effect/bounty_kingpin_offer/attack_hand(mob/living/user, list/modifiers)
	balloon_alert(user, "take the deal first!")
	return TRUE

/obj/effect/bounty_kingpin_offer/proc/on_item_deleted(datum/source)
	SIGNAL_HANDLER
	offer_item = null
	qdel(src)

/// The item goes to `user` (their hands, or at their feet) and the display goes. Returns the item.
/obj/effect/bounty_kingpin_offer/proc/hand_over(mob/living/user)
	var/obj/item/item = offer_item
	if(!item)
		qdel(src)
		return null
	UnregisterSignal(item, COMSIG_QDELETING)
	offer_item = null
	item.forceMove(get_turf(user) || get_turf(src))
	if(user)
		user.put_in_hands(item)
	qdel(src)
	return item

/// The black market goods he bribes with (shop SKUs), read at runtime for their items and worth: no ship systems, suits, blueprints or anything that skips progression
/proc/bounty_kingpin_bribe_skus()
	var/static/list/skus = list(
		/datum/shop_sku/black_market/mod_plate_compression,
		/datum/shop_sku/black_market/chameleon_mask,
		/datum/shop_sku/black_market/tactical_medkit,
		/datum/shop_sku/black_market/ew_shield_collapse,
		/datum/shop_sku/black_market/ew_fire_control_freeze,
		/datum/shop_sku/black_market/thermals,
		/datum/shop_sku/black_market/noslips,
		/datum/shop_sku/black_market/revolver,
		/datum/shop_sku/black_market/mod_energy_shield,
		/datum/shop_sku/black_market/mod_wraith_cloak,
		/datum/shop_sku/black_market/stimulants,
		/datum/shop_sku/black_market/sleepy_pen,
		/datum/shop_sku/black_market/rare/energy_shield,
		/datum/shop_sku/black_market/rotating/dart_pistol,
	)
	return skus

/// What a SKU is worth in credits, its voucher price folded in (as the shop's get_sku_value())
/proc/bounty_kingpin_sku_value(sku_type)
	var/datum/shop_sku/sku = sku_type
	return initial(sku.price_credits) + initial(sku.price_vouchers) * VOUCHER_CREDIT_VALUE

/// The items he may offer now: those worth BOUNTY_KINGPIN_BRIBE_MIN to _MAX, give or take BOUNTY_KINGPIN_BRIBE_SLACK. Item type -> worth.
/proc/bounty_kingpin_bribe_choices()
	var/list/choices = list()
	for(var/sku_type in bounty_kingpin_bribe_skus())
		if(!ispath(sku_type, /datum/shop_sku))
			continue
		var/datum/shop_sku/sku = sku_type
		var/item_type = initial(sku.item_path)
		if(!ispath(item_type, /obj/item))
			continue
		var/value = bounty_kingpin_sku_value(sku_type)
		if(value < BOUNTY_KINGPIN_BRIBE_MIN - BOUNTY_KINGPIN_BRIBE_SLACK || value > BOUNTY_KINGPIN_BRIBE_MAX + BOUNTY_KINGPIN_BRIBE_SLACK)
			continue
		choices[item_type] = value
	return choices

/// A random bribe's item type, or null
/proc/bounty_kingpin_pick_bribe()
	var/list/choices = bounty_kingpin_bribe_choices()
	return length(choices) ? pick(choices) : null

// =========================================================================
// HIS POSTING
// =========================================================================

/**
 * # The kingpin's posting
 *
 * P5's posting with his rules: "wanted dead or alive" (alive 100% however he got there, dead 80%),
 * a clock that stops during a shootout, no relisting (he is only ever on his sofa), and the deal.
 * A deal binds the dealing ship and everyone aboard or on its crew: none of them can hunt him or
 * turn him in, at any pad, while this posting is up.
 */
/datum/criminal_bounty/kingpin
	/// Deals he has made
	var/kingpin_deals = 0
	/// Weakrefs to the ships that took his deal
	var/list/kingpin_dealt_ships = list()
	/// Weakrefs to the minds bound by a deal
	var/list/kingpin_bound_minds = list()

/datum/criminal_bounty/kingpin/Destroy()
	. = ..()
	kingpin_dealt_ships.Cut()
	kingpin_bound_minds.Cut()

/// Whether `ship` took his deal
/datum/criminal_bounty/kingpin/proc/kingpin_ship_dealt(obj/structure/overmap/ship/ship)
	return !isnull(ship?.weak_reference) && (ship.weak_reference in kingpin_dealt_ships)

/// Whether `mind` is bound by his deal
/datum/criminal_bounty/kingpin/proc/kingpin_mind_bound(datum/mind/mind)
	return !isnull(mind?.weak_reference) && (mind.weak_reference in kingpin_bound_minds)

/**
 * Why `ship` (and `user`, pressing the button) can't hunt or turn him in, or null: the ship took his
 * deal, someone on its crew or aboard it is bound by a deal, or `user` is.
 */
/datum/criminal_bounty/kingpin/proc/kingpin_bound_refusal(obj/structure/overmap/ship/ship, mob/user)
	if(kingpin_ship_dealt(ship))
		return "your crew took his deal"
	if(user?.mind && kingpin_mind_bound(user.mind))
		return "you took his deal"
	if(!ship || !length(kingpin_bound_minds))
		return null
	for(var/datum/mind/member as anything in ship.ship_team?.members)
		if(kingpin_mind_bound(member))
			return "someone on your crew took his deal"
	for(var/datum/weakref/ref as anything in kingpin_bound_minds)
		var/datum/mind/bound = ref?.resolve()
		var/mob/living/body = bound?.current
		if(isliving(body) && body.stat != DEAD && get_ship_from_atom(body) == ship)
			return "someone aboard took his deal"
	return null

/**
 * `dealer` of `ship` took his deal: the ship, the dealer, its crew and everyone aboard it now are
 * bound; its hunt on him ends; it is told.
 */
/datum/criminal_bounty/kingpin/proc/kingpin_bind(obj/structure/overmap/ship/ship, mob/living/dealer)
	kingpin_deals++
	var/list/minds = list()
	if(dealer?.mind)
		minds |= dealer.mind
	if(ship)
		kingpin_dealt_ships |= WEAKREF(ship)
		for(var/datum/mind/member as anything in ship.ship_team?.members)
			if(member)
				minds |= member
		for(var/mob/living/aboard as anything in GLOB.alive_player_list)
			if(aboard.mind && get_ship_from_atom(aboard) == ship)
				minds |= aboard.mind
		var/datum/weakref/ship_ref = WEAKREF(ship)
		if(ship_ref in claimants)
			claimants -= ship_ref
			board_hunt_started -= ship_ref
			ship.remove_waypoint(board_waypoint_key())
		ship.ship_notify("WANTED: your crew took [record?.name || "the kingpin"]'s deal. None of you can collect on him now.", "MISSION CONTROL", SHIP_NOTIFY_WARNING, 'voidcrew/sound/notify2.ogg', 50)
	for(var/datum/mind/mind as anything in minds)
		kingpin_bound_minds |= WEAKREF(mind)
	SScriminal_bounties.board_changed()

// Wanted dead or alive: restrained, stunned or downed is alive and pays in full; dead pays 80%
/datum/criminal_bounty/kingpin/board_share_for(state, worst_state)
	if(!bounty_state_share(state))
		return 0
	if(state == BOUNTY_STATE_DEAD || worst_state == BOUNTY_STATE_DEAD)
		return BOUNTY_KINGPIN_PAY_DEAD
	return BOUNTY_KINGPIN_PAY_ALIVE

/datum/criminal_bounty/kingpin/board_share_amounts()
	var/list/alive = board_payout(BOUNTY_KINGPIN_PAY_ALIVE)
	var/list/dead = board_payout(BOUNTY_KINGPIN_PAY_DEAD)
	return list(alive[1], alive[1], dead[1])

/datum/criminal_bounty/kingpin/board_hint()
	return "Armed and guarded. Bring spare charges"

/datum/criminal_bounty/kingpin/board_pay_note()
	return "Wanted dead or alive: full pay alive, downed counts; 80% dead."

/datum/criminal_bounty/kingpin/board_place_text()
	if(board_relisting)
		return ..()
	return "In the lounge at [board_site_name || "the black market"]"

// The clock stops while his crew is fighting, and only then
/datum/criminal_bounty/kingpin/board_clock_held(now = world.time)
	var/mob/living/basic/bounty_criminal/kingpin/kingpin = criminal()
	return istype(kingpin) && !!kingpin.kingpin_crew?.is_fighting()

/datum/criminal_bounty/kingpin/hunt_refusal(obj/structure/overmap/ship/ship)
	var/refusal = kingpin_bound_refusal(ship)
	if(refusal)
		return refusal
	return ..()

// A ship bound by his deal can't turn him in, at any pad
/datum/criminal_bounty/kingpin/turn_in(obj/machinery/mission_pad/pad, obj/structure/overmap/ship/ship, mob/user)
	if(is_open())
		var/refusal = kingpin_bound_refusal(ship, user)
		if(refusal)
			return refusal
	return ..()

/datum/criminal_bounty/kingpin/board_pad_preview(obj/structure/overmap/ship/ship, obj/machinery/mission_pad/pad)
	var/list/preview = ..()
	if(length(preview) && kingpin_bound_refusal(ship))
		preview[1] = FALSE
	return preview

// He is only ever on his sofa: lost, the posting closes rather than listing somewhere else
/datum/criminal_bounty/kingpin/relist(reason)
	if(is_open())
		close(BOUNTY_CLOSE_NO_BODY)
	return FALSE

/datum/criminal_bounty/kingpin/close(reason, obj/structure/overmap/ship/winner)
	. = ..()
	if(.)
		SSbounty_kingpin.kingpin_resolved()

/// Seats him and his crew in the lounge at `where` when it has loaded (P5's board_arm() calls this async)
/datum/criminal_bounty/kingpin/board_spawn_criminal(obj/structure/overmap/where)
	var/mob/living/basic/bounty_criminal/kingpin/kingpin = bounty_kingpin_seat_at(where, record, src)
	board_spawning = FALSE
	if(QDELETED(kingpin))
		board_spawn_failures++
		if(board_spawn_failures >= BOUNTY_SPAWN_ATTEMPTS && is_open())
			log_game("BOUNTY: the [board_log_name()] found no lounge in [board_spawn_failures] tries")
			close(BOUNTY_CLOSE_NO_BODY)
		return null
	if(!is_open() || site() != where || criminal() || board_proof())
		qdel(kingpin)
		return null
	board_adopt_criminal(kingpin, where, null, null)
	return kingpin

// =========================================================================
// SEATING HIM
// =========================================================================

/// The ship `user` belongs to: the crew they fly with, else the ship they stand on
/proc/bounty_kingpin_user_ship(mob/user)
	if(!user)
		return null
	return get_crew_ship(user) || get_ship_from_atom(user)

/// Him and his crew in `outpost`'s lounge, found by its map marks. Returns him, or null.
/proc/bounty_kingpin_seat_at(obj/structure/overmap/trader_outpost/outpost, datum/bounty_record/record, datum/criminal_bounty/kingpin/posting)
	var/obj/effect/landmark/bounty_kingpin/seat/seat = bounty_kingpin_find_seat(outpost)
	if(!seat)
		return null
	return bounty_kingpin_setup(get_turf(seat), bounty_kingpin_find_posts(seat), record, posting)

/**
 * The kingpin in `record`'s face at `seat` (on its sofa), wanted on `posting`, with a goon at each of
 * `posts` (list(list(turf, BOUNTY_GOON_WEAPON_*), ...)), and his crew knowing the room. Returns him.
 */
/proc/bounty_kingpin_setup(turf/seat, list/posts, datum/bounty_record/record, datum/criminal_bounty/kingpin/posting)
	if(!seat)
		return null
	var/mob/living/basic/bounty_criminal/kingpin/kingpin = new(seat)
	kingpin.kingpin_crew = new /datum/bounty_kingpin_crew(kingpin, seat)
	kingpin.body_setup(record, posting)
	kingpin.kingpin_sit()
	for(var/list/post as anything in posts)
		kingpin.kingpin_crew.spawn_goon(post[1], post[2])
	kingpin.kingpin_crew.find_room()
	return kingpin

/// A new record for a kingpin: Most Wanted, his own archetype, a boss's alias and crime, a base value from his band
/proc/bounty_kingpin_make_record()
	var/datum/bounty_record/record = generate_bounty_record(BOUNTY_TIER_MOST_WANTED, BOUNTY_ARCHETYPE_NORMAL, BOUNTY_PLACEMENT_KINGPIN)
	if(!record)
		return null
	record.tier = BOUNTY_TIER_MOST_WANTED
	record.archetype = BOUNTY_ARCHETYPE_KINGPIN
	record.style = null
	record.kit = null
	var/alias = bounty_kingpin_line("record", "aliases")
	if(alias)
		record.alias = alias
	var/crime = bounty_kingpin_line("record", "crimes")
	if(crime)
		record.crime = crime
	record.base_value = rand(BOUNTY_KINGPIN_PAY_MIN, BOUNTY_KINGPIN_PAY_MAX)
	record.status = BOUNTY_RECORD_WANTED
	return record

/**
 * A kingpin posting on the board for `site` (the black market; null in tests, which takes red
 * space): his record, his band times the zone's multiplier, his vouchers (red adds one), 60 minutes
 * on the clock. It doesn't place him; board_arm() does.
 */
/proc/bounty_kingpin_new_posting(obj/structure/overmap/site)
	var/datum/bounty_record/record = bounty_kingpin_make_record()
	if(!record)
		return null
	var/zone = site ? SScriminal_bounties.board_site_zone(site) : ZONE_RED
	var/datum/criminal_bounty/kingpin/posting = new
	posting.record = record
	posting.placement_kind = BOUNTY_PLACEMENT_KINGPIN
	posting.board_zone = zone
	posting.value = SScriminal_bounties.board_value_for(record.base_value, zone)
	posting.board_vouchers = BOUNTY_KINGPIN_VOUCHERS + (zone == ZONE_RED ? BOUNTY_RED_VOUCHER_BONUS : 0)
	posting.board_posted_at = world.time
	posting.expires_at = world.time + BOUNTY_KINGPIN_EXPIRY
	posting.board_gps_tag = "[BOUNTY_GPS_TAG_PREFIX]-[record.id]"
	posting.RegisterSignal(record, COMSIG_BOUNTY_RECORD_MUGSHOT_READY, TYPE_PROC_REF(/datum/criminal_bounty, board_on_mugshot_ready))
	GLOB.criminal_bounties += posting
	if(site)
		posting.board_set_site(site)
	SScriminal_bounties.board_changed()
	log_game("BOUNTY: posted the [posting.board_log_name()] in zone [zone], worth [posting.value] cr and [posting.board_vouchers] voucher(s)")
	return posting

/// Posts the kingpin at `outpost`'s lounge and tells every crew. Returns the posting, or null.
/proc/post_kingpin_bounty(obj/structure/overmap/trader_outpost/outpost)
	if(QDELETED(outpost) || bounty_kingpin_open_posting())
		return null
	var/datum/criminal_bounty/kingpin/posting = bounty_kingpin_new_posting(outpost)
	if(!posting)
		return null
	var/list/amounts = posting.board_share_amounts()
	var/who = posting.record.alias ? "[posting.record.name], \"[posting.record.alias]\"" : posting.record.name
	for(var/obj/structure/overmap/ship/ship as anything in SSovermap.simulated_ships)
		if(QDELETED(ship) || ship.abandoned || istype(ship, /obj/structure/overmap/ship/npc))
			continue
		ship.ship_notify("WANTED DEAD OR ALIVE: [who], in the lounge at [outpost.name]. [amounts[1]] cr alive, [amounts[3]] cr dead.", "MISSION CONTROL", SHIP_NOTIFY_NOTICE, 'voidcrew/sound/notify.ogg', 50)
	posting.board_arm()
	return posting

/// The open kingpin posting, if there is one
/proc/bounty_kingpin_open_posting()
	for(var/datum/criminal_bounty/kingpin/posting in GLOB.criminal_bounties)
		if(posting.is_open())
			return posting
	return null

/// The black market (the Undertow Exchange), if there is one
/proc/bounty_kingpin_black_market()
	for(var/obj/structure/overmap/trader_outpost/black_market/outpost in GLOB.trader_outposts)
		if(!QDELETED(outpost))
			return outpost
	return null

// =========================================================================
// THE POSTING CLOCK
// =========================================================================

/**
 * # Kingpin postings
 *
 * Posts a kingpin now and then: the first no earlier than BOUNTY_KINGPIN_FIRST into the round and
 * only with BOUNTY_KINGPIN_MIN_SHIPS active ships, one at a time, the next BOUNTY_KINGPIN_GAP_MIN to
 * _MAX after the last one resolves (economy_v2.md 5.4: at most 0.75 an hour).
 */
SUBSYSTEM_DEF(bounty_kingpin)
	name = "Bounty Kingpin"
	wait = 30 SECONDS
	flags = SS_BACKGROUND | SS_NO_INIT
	runlevels = RUNLEVEL_GAME
	/// world.time the next kingpin may be posted: after the last one resolved, or after a failed try
	var/kingpin_next_at = 0
#ifdef UNIT_TESTS
	/// Whether it posts on its own clock. Off in tests, which post their own.
	var/kingpin_auto_post = FALSE
#else
	/// Whether it posts on its own clock. Off in tests, which post their own.
	var/kingpin_auto_post = TRUE
#endif

/datum/controller/subsystem/bounty_kingpin/fire(resumed)
	if(kingpin_auto_post)
		kingpin_post_if_due()

/datum/controller/subsystem/bounty_kingpin/stat_entry(msg)
	msg = "K:[bounty_kingpin_open_posting() ? 1 : 0]|next:[max(0, round((kingpin_next_at - world.time) / (1 MINUTES)))]m"
	return ..()

/**
 * Why no kingpin goes up now, or null if one may: `round_time` into the round, with
 * `active_ships` crewed ships, at world.time `now`.
 */
/datum/controller/subsystem/bounty_kingpin/proc/kingpin_post_refusal(round_time, active_ships, now = world.time)
	if(round_time < BOUNTY_KINGPIN_FIRST)
		return "too early in the round"
	if(active_ships < BOUNTY_KINGPIN_MIN_SHIPS)
		return "not enough ships about"
	if(bounty_kingpin_open_posting())
		return "one is up already"
	if(now < kingpin_next_at)
		return "too soon after the last"
	return null

/// Posts a kingpin at the black market if one is due. Returns the posting, or null.
/datum/controller/subsystem/bounty_kingpin/proc/kingpin_post_if_due()
	if(kingpin_post_refusal(world.time - SSticker.round_start_time, SScriminal_bounties.board_active_ships()))
		return null
	var/obj/structure/overmap/trader_outpost/outpost = bounty_kingpin_black_market()
	var/datum/criminal_bounty/kingpin/posting = outpost ? post_kingpin_bounty(outpost) : null
	if(!posting)
		kingpin_next_at = world.time + BOUNTY_KINGPIN_RETRY
	return posting

/// A kingpin posting resolved (claimed, expired, closed): the next waits BOUNTY_KINGPIN_GAP_MIN to _MAX
/datum/controller/subsystem/bounty_kingpin/proc/kingpin_resolved()
	kingpin_next_at = world.time + rand(BOUNTY_KINGPIN_GAP_MIN, BOUNTY_KINGPIN_GAP_MAX)

// =========================================================================
// OUTPOST SECURITY
// =========================================================================

/**
 * Called from the trader outpost's register_aggression() (one marked line in
 * voidcrew/modules/trade/outpost.dm): TRUE excuses `offender` a strike at `outpost`, because a
 * kingpin shootout is on there and the crew is fighting them (spec 13: hunters fighting his crew get
 * no property strikes). PvP enforcement stays: a hit on a person reaches register_aggression()
 * through register_pvp_aggression(), which has just opened the victim's self-defence window this
 * tick, and that is never excused.
 */
/proc/bounty_kingpin_excuses_aggression(obj/structure/overmap/trader_outpost/outpost, mob/living/offender)
	if(!outpost || !offender?.mind || !length(GLOB.bounty_kingpin_crews))
		return FALSE
	for(var/datum/bounty_kingpin_crew/crew as anything in GLOB.bounty_kingpin_crews)
		if(!crew.is_fighting() || !crew.is_hunter(offender))
			continue
		if(get_trader_outpost_for_turf(crew.crew_seat) != outpost)
			continue
		if(bounty_kingpin_pvp_strike_now(outpost, offender))
			return FALSE
		return TRUE
	return FALSE

/// Whether `offender` hit a person at `outpost` this very tick (register_pvp_aggression() has just set that victim's self-defence window)
/proc/bounty_kingpin_pvp_strike_now(obj/structure/overmap/trader_outpost/outpost, mob/living/offender)
	var/due = world.time + OUTPOST_SELF_DEFENSE_DURATION
	for(var/datum/mind/victim as anything in outpost.self_defense_targets)
		var/list/targets = outpost.self_defense_targets[victim]
		if(LAZYACCESS(targets, offender.mind) == due)
			return TRUE
	return FALSE

// =========================================================================
// WHAT THE HUNTERS SAY
// =========================================================================

/// `user` says their line for talk option `option`
/proc/bounty_kingpin_hunter_says(mob/living/user, option)
	var/context
	switch(option)
		if(BOUNTY_KINGPIN_TALK_HERE)
			context = "here"
		if(BOUNTY_KINGPIN_TALK_OFFER)
			context = "offer"
		if(BOUNTY_KINGPIN_TALK_TAKE)
			context = "take"
		if(BOUNTY_KINGPIN_TALK_NO_DEAL)
			context = "no_deal"
		if(BOUNTY_KINGPIN_TALK_WALK)
			context = "walk"
	var/line = context ? bounty_kingpin_line("hunter", context) : null
	if(line && user.stat == CONSCIOUS)
		user.say(line, forced = "bounty kingpin talk")

